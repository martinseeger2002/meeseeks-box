#!/bin/bash
# The agent inside the box: Qwen Code (installed by setup.sh into vendor/), talking to
# the model in box.env. Started by the relay (relay/serve.py), not by hand.
BOX="$(cd "$(dirname "$0")/.." && pwd)"
ENTRY="$BOX/vendor/node_modules/@qwen-code/qwen-code/cli-entry.js"

[ -f "$ENTRY" ] || { echo "[qwen-local] Qwen Code is not installed - run ./setup.sh"; exit 1; }
if ! curl -sf -m 10 -H "Authorization: Bearer $OPENAI_API_KEY" \
     "${OPENAI_BASE_URL%/}/models" >/dev/null 2>&1; then
  echo "[qwen-local] the model is not answering at $OPENAI_BASE_URL (check the key in box.env)"
  exit 1
fi
exec node "$ENTRY" "$@"
