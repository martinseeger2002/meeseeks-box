# Copied to box.env by setup.sh. box.env may hold a key: never share it or commit it.
# Any OpenAI-compatible server works: vLLM, llama.cpp (llama-server), Ollama, LM Studio,
# or a hosted API. Examples:
#   vLLM / llama-server : http://localhost:8000/v1   (llama-server defaults to :8080)
#   Ollama              : http://localhost:11434/v1
#   LM Studio           : http://localhost:1234/v1
OPENAI_BASE_URL=http://localhost:8000/v1
# Local servers usually don't check the key; any non-empty value works.
OPENAI_API_KEY=none
# The model name as your server lists it at $OPENAI_BASE_URL/models
OPENAI_MODEL=
PORT=8491
TITLE="Meeseeks Box"
